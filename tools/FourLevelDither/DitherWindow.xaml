<Window x:Class="DiscImageStudio.DitherTool.DitherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="B&amp;W Dither" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7" Foreground="#19212C"
        FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True"
        AllowDrop="True" PreviewDragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8DEE7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DEE3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="B&amp;W Dither" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Blend black and white pixels to preserve shading, preserve original dimensions, and export lossless PNG." Foreground="#626D7D" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OpenButton" Content="Open Image" Click="Open_Click" />
                <Button x:Name="SaveButton" Content="Save B&amp;W PNG" Click="Save_Click" IsEnabled="False"
                        Background="#245BCC" Foreground="White" BorderBrush="#245BCC" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="Disc Type" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="ModePicker" Width="225" Padding="8,5" SelectedIndex="0" SelectionChanged="Mode_SelectionChanged">
                    <ComboBoxItem Content="DVD Binary · 0 / 255" />
                    <ComboBoxItem Content="CD Binary · 0 / 255" />
                </ComboBox>
                <TextBlock x:Name="ModeHint" Text="A5 → Black 0 · 92 → White 255" Foreground="#626D7D" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <CheckBox x:Name="GammaToggle" Content="sRGB Gamma Correction" IsChecked="False" VerticalAlignment="Center"
                          Checked="Gamma_Changed" Unchecked="Gamma_Changed" />
                <TextBlock Grid.Column="1" x:Name="GammaHint" Text="Disabled: Preserves existing shading distribution" Foreground="#626D7D" FontSize="12"
                           VerticalAlignment="Center" Margin="18,0,0,0" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Grid.Row="2" x:Name="FileText" Text="Open an image, or drag and drop a file into this window" Foreground="#626D7D" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ActualSizeToggle" Content="100% Pixel View" Margin="16,0,0,0" VerticalAlignment="Center"
                      Checked="PreviewMode_Changed" Unchecked="PreviewMode_Changed" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Margin="18,15"><TextBlock Text="Original" FontWeight="SemiBold" /><TextBlock x:Name="SourceInfo" Text="Preserve original dimensions" FontSize="12" Foreground="#626D7D" Margin="0,4,0,0" /></StackPanel>
                    <Grid Grid.Row="1" Background="#E9ECF0" Margin="8,0,8,8">
                        <ScrollViewer x:Name="SourceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Preview_SizeChanged">
                            <Image x:Name="SourceImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
                        </ScrollViewer>
                        <TextBlock x:Name="SourcePlaceholder" Text="Drop PNG / JPG / BMP / TIFF / GIF here" Foreground="#738095" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Margin="18,15"><TextBlock x:Name="ResultHeading" Text="DVD Binary Dither Result" FontWeight="SemiBold" /><TextBlock x:Name="ResultDetails" Text="Serpentine Floyd–Steinberg · sRGB Gamma: Off · Lossless PNG" FontSize="12" Foreground="#626D7D" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                    <Grid Grid.Row="1" Background="#E9ECF0" Margin="8,0,8,8">
                        <ScrollViewer x:Name="ResultScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Preview_SizeChanged">
                            <Image x:Name="ResultImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </ScrollViewer>
                        <TextBlock x:Name="ResultPlaceholder" Text="Select an image to process automatically" Foreground="#738095" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,17,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Preserve original size · Composite transparency over white · Do not overwrite original file" Foreground="#626D7D" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#000000" Width="26" Height="20" CornerRadius="3" /><TextBlock Text="0" Margin="6,0,12,0" />
                    <Border Background="White" BorderBrush="#D8DEE7" BorderThickness="1" Width="26" Height="20" CornerRadius="3" /><TextBlock Text="255" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
            <ProgressBar x:Name="BusyBar" Height="3" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#626D7D" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</Window>
