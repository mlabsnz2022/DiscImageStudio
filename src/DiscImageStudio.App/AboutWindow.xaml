<Window x:Class="DiscImageStudio.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiscImageStudio.Controls"
        Title="About Disc Image Studio"
        Width="720" SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="32" CornerRadius="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" ProjectTitle="About"
                           ShowMinimizeButton="False" ShowMaximizeButton="False" />

        <!-- About is a dialog, not a workspace: it has no task of its own and does not belong
             in the navigation the way a work surface does. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="28,20,28,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource AppIconSource}" Width="64" Height="64" VerticalAlignment="Center" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Disc Image Studio" Style="{StaticResource CardTitle}" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource BodyText}" Margin="0,24,0,0"
                           Text="Disc Image Studio is an all-in-one workstation for creating visible disc art patterns on optical media." />
                <TextBlock Style="{StaticResource CompactHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="This project is released under the GNU General Public License v3.0 or later; redistribution must include the corresponding source code and retain third-party notices." />

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Open Source Components" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="HarmonyOS Sans SC — HarmonyOS Sans Font License Agreement" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                               Text="MahApps.Metro.IconPacks.Lucide (Lucide Icons) — MIT License" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                               Text="CommunityToolkit.Mvvm — Apache License 2.0" />
                </StackPanel>

                <Expander Header="GNU GPL v3.0 or later (Project License)" Margin="0,20,0,0">
                    <TextBox Text="{Binding LicenseText, Mode=OneWay}" IsReadOnly="True" Height="240"
                             Margin="0,8,0,0" Style="{StaticResource BareTextBox}"
                             FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Expander>
                <Expander Header="Third-Party Notices" Margin="0,8,0,0">
                    <TextBox Text="{Binding ThirdPartyNoticesText, Mode=OneWay}" IsReadOnly="True" Height="240"
                             Margin="0,8,0,0" Style="{StaticResource BareTextBox}"
                             FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Expander>
                <Expander Header="HarmonyOS Sans Font License" Margin="0,8,0,0">
                    <TextBox Text="{Binding FontLicenseText, Mode=OneWay}" IsReadOnly="True" Height="180"
                             Margin="0,8,0,0" Style="{StaticResource BareTextBox}"
                             FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
